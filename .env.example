DEEPSEEK_API_KEY=
CLASSBOT_SUBJECT=马克思主义基本原理
CLASSBOT_COURSE=marxism_basic_principles_2023
CLASSBOT_MODEL=deepseek-flash
CLASSBOT_BASE_URL=https://api.deepseek.com
CLASSBOT_ASR_DEVICE=cpu
# Final full-segment ASR review improves accuracy at the cost of some latency.
CLASSBOT_FINAL_REFINEMENT=true
# Classroom reasoning; online defense has its own low-latency default.
CLASSBOT_THINKING=high
CLASSBOT_DEFENSE_THINKING=none
# Default opens the online defense workspace; use classroom for the legacy mode.
CLASSBOT_MODE=defense
# Local semantic model (first index build downloads safe weights into .cache).
CLASSBOT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# CLASSBOT_CACHE_DIR=D:/ClassbotCache
