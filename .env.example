DEEPSEEK_API_KEY=
CLASSBOT_SUBJECT=马克思主义基本原理
CLASSBOT_COURSE=marxism_basic_principles_2023
CLASSBOT_MODEL=deepseek-flash
CLASSBOT_BASE_URL=https://api.deepseek.com
CLASSBOT_ASR_DEVICE=cpu
# For NVIDIA RTX 50-series (Blackwell) install the CUDA wheels first, then
# switch CLASSBOT_ASR_DEVICE=cuda:
#   .venv\Scripts\python.exe -m pip install "torch==2.14.1+cu130" "torchaudio==2.11.0+cu130" --index-url https://download.pytorch.org/whl/cu130
# Final full-segment ASR review improves accuracy at the cost of some latency.
CLASSBOT_FINAL_REFINEMENT=true
# Refinement model: seaco = offline SeACo-Paraformer + punctuation (default,
# downloads once on first use, uses course hotwords), stream = legacy
# streaming re-decode, off = no refinement even with FINAL_REFINEMENT=true.
CLASSBOT_ASR_REFINER=seaco
# Realtime punctuation on streaming partials (ct-punc-c): gives the live
# question detector its clause boundaries and ？ marks. Adds ~10-60ms per
# partial on GPU. Set false to emit raw unpunctuated partials.
CLASSBOT_ASR_PARTIAL_PUNC=true
# Hybrid answer mode: on = local materials + web retrieval; off = local only.
# Internal source tags are [S#]/[W#]/[G]; the UI shows 教/PPT/代码文件名/文/PDF/网/通识.
# Code sources show the file name inline and the absolute path in the source panel.
CLASSBOT_WEB_SEARCH=on
# Fetch depth: auto = fetch 1-2 pages only when snippets are thin; off = snippets only;
# always = fetch 1-2 pages for every web query.
CLASSBOT_WEB_FETCH=auto
CLASSBOT_WEB_SEARCH_TIMEOUT=1.8
CLASSBOT_WEB_FETCH_TIMEOUT=1.0
# Classroom reasoning; online defense has its own low-latency default.
CLASSBOT_THINKING=high
CLASSBOT_DEFENSE_THINKING=none
# Default opens the online defense workspace; use classroom for the legacy mode.
CLASSBOT_MODE=defense
# Local semantic model (first index build downloads safe weights into .cache).
CLASSBOT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# CLASSBOT_CACHE_DIR=D:/ClassbotCache
